{
  "manifest_version": 3,
  "name": "Red Flagger",
  "version": "2.0.1",
  "description": "Flags likely scam and phishing sites with local checks and the OpenPhish blocklist. Your browsing never leaves the browser.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://raw.githubusercontent.com/openphish/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Red Flagger",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
